# Server-only key for live web search. Never expose this through NEXT_PUBLIC_ variables.
TAVILY_API_KEY=

# AI provider keys. Use any one of these for the server chat route.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional app URL used by OpenRouter requests.
NEXT_PUBLIC_APP_URL=http://localhost:3000
